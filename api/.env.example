# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000
SERVE_UNPUBLISHED=false
LIMITER_STORE=database
#--------------------------------------------------------------------
# Email (verification and password reset)
#--------------------------------------------------------------------
# Development: "file" writes each email to tmp/mail instead of sending it.
# Production MUST use "smtp"; the server refuses to start with "file".
MAIL_TRANSPORT=file
MAIL_FROM="Plants API <no-reply@localhost>"
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURE=false
# Where the dashboard lives; links in emails point here.
WEB_URL=http://localhost:3000

# Optional: where the SQLite file lives (default: tmp/db.sqlite3)
# SQLITE_PATH=
