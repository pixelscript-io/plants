# ---- Server only (never sent to the browser) ----

# Where the dashboard's server reaches the Plants API. Can be an internal address.
NUXT_API_URL=http://localhost:3333/api/v1

# REQUIRED in production: a random secret of 32+ characters that seals the session
# cookie. The server refuses to start without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it signs everyone out. In development a built-in insecure value is used.
NUXT_SESSION_PASSWORD=

# The session cookie is Secure (HTTPS only) in production builds. Set to false ONLY to
# try a production build over plain http on your own machine.
# NUXT_COOKIE_SECURE=false

# Trust X-Forwarded-For / X-Forwarded-Host. Turn on only behind a reverse proxy you
# control; otherwise a client could spoof its address to evade the login throttle.
# NUXT_TRUST_PROXY=true

# ---- Public (visible in the browser) ----

# The API's public URL, shown in code examples. The browser never calls it directly.
NUXT_PUBLIC_API_BASE=http://localhost:3333/api/v1

# API reference page, linked from the sidebar
NUXT_PUBLIC_DOCS_URL=http://localhost:3333/docs
